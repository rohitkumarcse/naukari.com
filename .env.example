NAUKRI_PASSWORD='Rohit@96@17#04'

# Key skills update
# Optional, comma separated. Skills to make sure are present on the profile.
KEY_SKILLS_ADD=ajax
# Optional, comma separated. Skills to remove from the profile.
KEY_SKILLS_REMOVE=ajax
# If both are empty the script does a "refresh": it removes one existing skill
# and adds the same skill back, so the profile is saved with no net change.

# Scheduler (npm run schedule): runs the update every day at RUN_TIME
RUN_TIME=06:00
SCHEDULE_TZ=Asia/Kolkata
# If the PC was off/asleep at RUN_TIME, run once when it comes back (within the window)
CATCH_UP_MISSED=true
CATCH_UP_WINDOW_MIN=360
